{
  "name": "easel",
  "version": "1.0.0",
  "description": "Web node canvas engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
     "build": "tsup",
    "build:lib": "tsup",
    "build:playground": "vite build",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.12.4",
  "onlyBuiltDependencies": ["esbuild"],
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@vue/reactivity": "^3.5.34",
    "eventemitter3": "^5.0.4",
    "fp-ts": "^2.16.11"
